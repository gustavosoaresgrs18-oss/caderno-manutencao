<?xml version="1.0" encoding="utf-8"?>
<!-- Cores do icone e da tela de abertura.

     ATENCAO: dois tracinhos seguidos NAO podem aparecer dentro de um comentario
     XML — o parser aborta o build inteiro com "A string nao e permitida nos
     comentarios". Se precisar citar uma variavel CSS, escreva "var bg" sem os
     tracinhos. -->
<resources>
    <!-- Fundo do icone adaptativo. E COR CHAPADA de proposito: alguns launchers
         aplicam paralaxe no fundo (ele desliza atras da arte quando voce
         arrasta), e degrade nesse movimento fica sujo. -->
    <color name="ic_launcher_background">#10231B</color>

    <!-- Fundo da tela de abertura. E o MESMO fundo do app (bg do Copiloto), pra
         a splash emendar na primeira tela sem piscar branco no meio. -->
    <color name="copiloto_splash_bg">#0B0F14</color>
</resources>
